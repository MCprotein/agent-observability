@@ -8666,4 +8666,110 @@ mod tests {
     fn allocated_bytes(metadata: &fs::Metadata) -> u64 {
         metadata.len()
     }
+
+    #[test]
+    #[ignore = "review-only producer for an exact local_state.v6 compatibility fixture"]
+    fn review_produce_local_state_v6_fixture() {
+        let output = PathBuf::from(
+            std::env::var_os("AGENTOBS_V6_FIXTURE_OUTPUT")
+                .expect("AGENTOBS_V6_FIXTURE_OUTPUT must name the review artifact"),
+        );
+        assert_eq!(
+            output.file_name().and_then(|name| name.to_str()),
+            Some("local_state_v6.sqlite3")
+        );
+        assert!(!output.exists(), "review artifact must not be overwritten");
+
+        let dir = temp_dir("review-exact-v6-fixture");
+        let _ = fs::remove_dir_all(&dir);
+        let mut store = LocalStore::open(&dir).unwrap();
+        store.ingest(&observation("1", "session", None)).unwrap();
+        assert!(store.acknowledge_report_generation(1).unwrap());
+        store
+            .ingest(&observation_after("2", Some("1"), "turn", Some("session")))
+            .unwrap();
+        store
+            .db
+            .execute(
+                "UPDATE metadata SET value='7' WHERE key=?1",
+                [REPORT_VISIBILITY_EPOCH_KEY],
+            )
+            .unwrap();
+        store
+            .db
+            .execute(
+                "INSERT INTO metadata(key,value) VALUES('compatibility_fixture_padding',?1)",
+                ["x".repeat(MAX_CODEX_CORRELATION_STATE_BYTES)],
+            )
+            .unwrap();
+
+        assert_eq!(
+            store.report_status().unwrap(),
+            ReportStatus {
+                generation: 2,
+                acknowledged_generation: 1,
+            }
+        );
+        assert_eq!(store.report_visibility_epoch().unwrap(), 7);
+        assert_eq!(store.record_count().unwrap(), 2);
+        let database = store.database_path();
+        drop(store);
+        fs::copy(&database, &output).unwrap();
+        let _ = fs::remove_dir_all(dir);
+        eprintln!("review_v6_fixture={}", output.display());
+    }
+
+    #[test]
+    #[ignore = "review-only baseline accessor verification for v6 and v7 artifacts"]
+    fn review_verify_baseline_accessor_contract() {
+        fn copied_store(label: &str, source: &Path) -> PathBuf {
+            let dir = temp_dir(label);
+            let _ = fs::remove_dir_all(&dir);
+            private_dir(&dir).unwrap();
+            let destination = dir.join(DB_NAME);
+            fs::copy(source, &destination).unwrap();
+            #[cfg(unix)]
+            {
+                use std::os::unix::fs::PermissionsExt;
+                fs::set_permissions(&destination, fs::Permissions::from_mode(0o600)).unwrap();
+            }
+            dir
+        }
+
+        let v6 = PathBuf::from(
+            std::env::var_os("AGENTOBS_V6_FIXTURE_INPUT")
+                .expect("AGENTOBS_V6_FIXTURE_INPUT must name the baseline artifact"),
+        );
+        let v6_dir = copied_store("review-v6-accessor", &v6);
+        let store = LocalStore::open_current(&v6_dir).unwrap();
+        assert_eq!(
+            store.report_status().unwrap(),
+            ReportStatus {
+                generation: 2,
+                acknowledged_generation: 1,
+            }
+        );
+        assert_eq!(store.report_visibility_epoch().unwrap(), 7);
+        assert_eq!(store.record_count().unwrap(), 2);
+        let padding: i64 = store
+            .db
+            .query_row(
+                "SELECT length(value) FROM metadata WHERE key='compatibility_fixture_padding'",
+                [],
+                |row| row.get(0),
+            )
+            .unwrap();
+        assert_eq!(padding, 512 * 1024);
+        drop(store);
+        fs::remove_dir_all(v6_dir).unwrap();
+
+        if let Some(v7) = std::env::var_os("AGENTOBS_V7_FIXTURE_INPUT") {
+            let v7_dir = copied_store("review-v7-rejected-by-v6", Path::new(&v7));
+            assert!(matches!(
+                LocalStore::open_current(&v7_dir),
+                Err(StoreError::SchemaMismatch)
+            ));
+            fs::remove_dir_all(v7_dir).unwrap();
+        }
+    }
 }
